# ─────────────────────────────────────────────────────────────────────────────
# NotifyHub — production settings (docker/docker-compose.prod.yml)
#
#   cp .env.production.example .env.production
#   then fill in every "CHANGE_ME" (see docs/self-hosting.md)
#
# Database/Redis connection URLs are built by docker-compose.prod.yml from the
# passwords below — don't set DATABASE_URL, MONGO_URI or REDIS_HOST here.
# Every other setting from docs/configuration.md can be added to this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Passwords for the bundled databases (required) ──────────────────────────
# Letters and digits only (they go into connection URLs). Generate each with:
#   openssl rand -hex 24
# Set them BEFORE the first start: the databases are created with them.
POSTGRES_PASSWORD=CHANGE_ME
MONGO_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# ── Secrets (required) — generate each with: openssl rand -hex 32 ───────────
OTP_SECRET=CHANGE_ME
# Signs dashboard logins and inbox subscriber tokens. Changing it logs everyone out.
JWT_SECRET=CHANGE_ME

# ── Where the API listens ───────────────────────────────────────────────────
# Port on this machine. With the HTTPS profile, set API_BIND=127.0.0.1 so the
# API is only reachable through Caddy.
API_PORT=3000
API_BIND=0.0.0.0
# Your public domain, for automatic HTTPS (--profile https), e.g. notify.example.com
# DOMAIN=

# ── Browser access (in-app inbox UI) ────────────────────────────────────────
# Websites allowed to call NotifyHub from a browser. Use your app's address(es).
CORS_ORIGINS=https://app.example.com

# ── Email ───────────────────────────────────────────────────────────────────
# Empty = email disabled. Set to smtp (or brevo, or brevo,smtp) and fill in
# the provider's settings below. Guide: docs/email-providers.md
EMAIL_PROVIDERS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="My App <you@gmail.com>"
# BREVO_API_KEY=
# BREVO_FROM="My App <no-reply@yourdomain.com>"

# ── Accounts ────────────────────────────────────────────────────────────────
# The first account created is the admin; after that signup is closed.
# SIGNUP_ENABLED=false
# EMAIL_VERIFICATION_REQUIRED=false

# ── Tools ───────────────────────────────────────────────────────────────────
# Queue dashboard at /queues — only served in production when a password is set.
# BULL_BOARD_USERNAME=admin
# BULL_BOARD_PASSWORD=
# Interactive API docs at /docs. Set false to hide them.
# SWAGGER_ENABLED=true

# ── Performance (see docs/scaling.md) ───────────────────────────────────────
# EMAIL_WORKER_CONCURRENCY=5
# IN_APP_WORKER_CONCURRENCY=10
