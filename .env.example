# ─────────────────────────────────────────────────────────────────────────────
# NotifyHub configuration.  cp .env.example .env
#
# REQUIRED settings are uncommented below — the app won't start without them.
# OPTIONAL settings are commented out and show their DEFAULT (from
# src/config/config.defaults.ts). Uncomment and change only what you need.
# ─────────────────────────────────────────────────────────────────────────────

# ── HTTP ─────────────────────────────────────────────────────────────────────
# NODE_ENV=development
# PORT=3000
# Websites allowed to call the API from a browser (the in-app inbox UI).
# * = any. In production list yours: https://app.example.com,http://localhost:5173
# CORS_ORIGINS=*

# ── Databases (required) — values match docker/docker-compose.yml ────────────
DATABASE_URL=postgresql://notifyhub:notifyhub@localhost:5432/notifyhub
MONGO_URI=mongodb://notifyhub:notifyhub@localhost:27017/notifyhub?authSource=admin

# ── Redis — queues, OTPs, idempotency ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# Fail a Redis command after this long instead of hanging during an outage
# REDIS_COMMAND_TIMEOUT_MS=2000

# ── Email providers ──────────────────────────────────────────────────────────
# Which providers send email, tried in this order (failover):
#   EMAIL_PROVIDERS=smtp          one provider
#   EMAIL_PROVIDERS=brevo,smtp    Brevo first; if it fails, SMTP
#   EMAIL_PROVIDERS=              email disabled (then EMAIL_VERIFICATION_REQUIRED must be false)
# Available: smtp, brevo. Each listed provider needs its settings below.
EMAIL_PROVIDERS=smtp

# ── SMTP — Mailpit locally (UI: http://localhost:8025) ───────────────────────
# Needed when EMAIL_PROVIDERS includes "smtp".
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="NotifyHub <no-reply@notifyhub.local>"
# true for port 465 (implicit TLS); false for 25/587/1025
# SMTP_SECURE=false
# Leave empty for Mailpit. Gmail: your address + an App Password.
# SMTP_USER=
# SMTP_PASS=
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=20000
# Reuse open connections (much faster for many emails); max per worker process
# SMTP_POOL=true
# SMTP_MAX_CONNECTIONS=5
# SMTP_MAX_MESSAGES=100

# ── Brevo (https://www.brevo.com, free: 300 emails/day) ─────────────────────
# Needed when EMAIL_PROVIDERS includes "brevo".
# API key: Brevo → SMTP & API → API Keys. BREVO_FROM must be a verified sender.
# BREVO_API_KEY=
# BREVO_FROM="NotifyHub <you@yourdomain.com>"
# Max wait for Brevo before trying the next provider
# BREVO_TIMEOUT_MS=10000

# ── In-app inbox (docs/in-app-inbox.md) ──────────────────────────────────────
# Built in, no outside service. false = the in_app channel is disabled.
# IN_APP_ENABLED=true
# How long a subscriber token (POST /v1/inbox/tokens) works: 15m, 12h, 7d
# INBOX_TOKEN_EXPIRES_IN=12h

# ── Secrets (required) — generate each with: openssl rand -hex 32 ────────────
# Hashes OTP codes before they are stored in Redis
OTP_SECRET=change-me-to-a-random-32+-char-secret
# Signs login tokens (JWTs). Changing it logs everyone out.
JWT_SECRET=change-me-to-a-random-32+-char-secret

# ── Auth ─────────────────────────────────────────────────────────────────────
# How long a login token is valid: 15m, 8h, 7d...
# JWT_EXPIRES_IN=8h
# Require an emailed OTP before first login? (true needs working SMTP)
# EMAIL_VERIFICATION_REQUIRED=false
# Allow anyone to sign up? false = only the first (admin) account can be created
# SIGNUP_ENABLED=false

# ── OTP (email verification codes) ───────────────────────────────────────────
# OTP_TTL_SECONDS=900
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60

# ── Queues (BullMQ) ──────────────────────────────────────────────────────────
# Attempts per notification (1 try + retries)
# QUEUE_MAX_ATTEMPTS=5
# First retry delay; doubles each time (2s, 4s, 8s, 16s)
# QUEUE_BACKOFF_DELAY_MS=2000
# How long Redis keeps finished jobs (Mongo keeps the real log)
# QUEUE_KEEP_COMPLETED_SECONDS=86400
# QUEUE_KEEP_COMPLETED_COUNT=1000
# How long failed jobs stay in the dead letter queue
# QUEUE_KEEP_FAILED_SECONDS=604800
# Max wait for Redis when the API adds a job (→ 503 instead of hanging)
# QUEUE_ENQUEUE_TIMEOUT_MS=3000

# ── Workers ──────────────────────────────────────────────────────────────────
# Emails sent in parallel by one worker process
# EMAIL_WORKER_CONCURRENCY=5
# In-app messages saved in parallel by one worker process
# IN_APP_WORKER_CONCURRENCY=10

# ── Trigger API ──────────────────────────────────────────────────────────────
# Same idempotencyKey within this window is treated as a duplicate
# IDEMPOTENCY_TTL_SECONDS=86400

# ── API keys ─────────────────────────────────────────────────────────────────
# API_KEYS_MAX_ACTIVE_PER_TENANT=20

# ── Health ───────────────────────────────────────────────────────────────────
# Max time each dependency gets to answer GET /health
# HEALTH_PROBE_TIMEOUT_MS=2000

# ── API docs (Swagger UI at http://localhost:3000/docs) ──────────────────────
# SWAGGER_ENABLED=true
# SWAGGER_PATH=docs

# ── Queue dashboard (Bull Board at http://localhost:3000/queues) ─────────────
# Shows waiting/active/completed/failed jobs; can retry or delete them.
# BULL_BOARD_ENABLED=true
# BULL_BOARD_PATH=queues
# With a password set, the browser asks for username + password.
# Without one it's open in development and NOT served in production.
# BULL_BOARD_USERNAME=admin
# BULL_BOARD_PASSWORD=
# true = view only (no retry/delete/clean buttons)
# BULL_BOARD_READ_ONLY=false
